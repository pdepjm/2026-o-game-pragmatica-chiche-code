import wollok.game.*

import example.*

program LluviaDeObjetos {
	game.title("Lluvia de objetos")
	game.height(12)
	game.width(10)
	game.cellSize(60)
	game.ground("celda.png")
	game.addVisual(personaje)
	game.addVisual(ejemplo)

	const generadorComida = new GeneradorObjetos(crear = {new Comida()})
	const generadorBomba = new GeneradorObjetos(crear = {new Bomba()})

	keyboard.left().onPressDo({ personaje.moverIzquierda() })
	keyboard.a().onPressDo({ personaje.moverIzquierda() })

	keyboard.right().onPressDo({ personaje.moverDerecha() })
	keyboard.d().onPressDo({ personaje.moverDerecha() })

	keyboard.space().onPressDo({ personaje.saltar() })
	keyboard.w().onPressDo({ personaje.saltar() })

	game.onCollideDo(personaje, { objeto => objeto.serAgarrado() })

	game.onTick(2000, "Generar comida", {
		generadorComida.generar()
	})

	game.onTick(2500, "Generar bomba", {
		generadorBomba.generar()
	})

	game.onTick(600, "caida", {
		generadorComida.actualizar()
		generadorBomba.actualizar()
	})

	game.onTick(1500, "crear lanza a la izquierda en el piso", {
		const advertencia = new Advertencia()

		advertencia.spawn("izquierda", "piso")
		game.addVisual(advertencia)
		advertencia.animacion()
		game.removeTickEvent("crear lanza a la izquierda en el piso")
	})

	game.onTick(4000, "crear lanza a la derecha en el piso", {
		const advertencia = new Advertencia()

		advertencia.spawn("derecha", "piso")
		game.addVisual(advertencia)
		advertencia.animacion()
		game.removeTickEvent("crear lanza a la derecha en el piso")
	})
	
	game.onTick(4000, "crear lanza a la izquierda en el aire", {
		const advertencia = new Advertencia()

		advertencia.spawn("izquierda", "aire")
		game.addVisual(advertencia)
		advertencia.animacion()
		game.removeTickEvent("crear lanza a la izquierda en el aire")
	})

	game.onTick(1500, "crear lanza a la derecha en el aire", {
		const advertencia = new Advertencia()

		advertencia.spawn("derecha", "aire")
		game.addVisual(advertencia)
		advertencia.animacion()
		game.removeTickEvent("crear lanza a la derecha en el aire")
	})

	game.start()
}